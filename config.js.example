// Copy this file as "config.js" and fill in your Supabase project values.
// These two values are safe to put in a browser app when Row Level Security (RLS)
// is correctly enabled by schema.sql. NEVER put a service_role key here.
window.SUPABASE_URL = "https://YOUR-PROJECT.supabase.co";
window.SUPABASE_ANON_KEY = "YOUR-ANON-PUBLIC-KEY";